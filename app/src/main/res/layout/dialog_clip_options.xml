<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:background="@drawable/dialog_clip_options_neon"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/popup_clip_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#162842"
        android:ellipsize="end"
        android:maxLines="1"
        android:padding="6dp"
        android:textColor="#E0E6ED"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/popup_btn_pin"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_editor_key"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/popup_pin_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_pin_cyan" />

        <TextView
            android:id="@+id/popup_pin_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/pin_text"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/popup_btn_delete"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_editor_key"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_trash_cyan" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/keycode_delete"
            android:textColor="#FF5252"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/popup_btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:background="@drawable/ripple_all_corners_medium"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/cancel"
        android:textColor="#80A0C0"
        android:textSize="11sp" />

</LinearLayout>
