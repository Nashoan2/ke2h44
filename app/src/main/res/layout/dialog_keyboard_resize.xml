<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0A1120"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <!-- Title and Current Value -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/dialog_resize_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="@string/keyboard_height"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialog_resize_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_resize_pill"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:textColor="#00E5FF"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="100%" />
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="100% - 180%"
        android:textColor="#80A0C0"
        android:textSize="13sp" />

    <!-- Slider with Plus and Minus controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/btn_height_minus"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_editor_key"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="-"
            android:textColor="#00E5FF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekbar_keyboard_height"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:max="80"
            android:progress="0"
            android:theme="@style/Widget.AppCompat.SeekBar" />

        <TextView
            android:id="@+id/btn_height_plus"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_editor_key"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="+"
            android:textColor="#00E5FF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Preset quick selection buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        android:weightSum="5">

        <TextView
            android:id="@+id/btn_preset_100"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/bg_editor_key"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="100%"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_preset_120"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/bg_editor_key"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="120%"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_preset_140"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/bg_editor_key"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="140%"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_preset_160"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/bg_editor_key"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="160%"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_preset_180"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/bg_editor_key"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="180%"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Dialog Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/dialog_btn_resize_reset"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/ripple_all_corners_medium"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/resize_reset"
            android:textColor="#80A0C0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dialog_btn_resize_cancel"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/ripple_all_corners_medium"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/cancel"
            android:textColor="#80A0C0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dialog_btn_resize_done"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_editor_key"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/ok"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
