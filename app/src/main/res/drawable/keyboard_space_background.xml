<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item
                android:bottom="1dp"
                android:left="2dp"
                android:right="2dp"
                android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#0B4A78" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#00E5FF" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:bottom="0dp"
                android:left="2dp"
                android:right="2dp"
                android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#070E1A" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item
                android:bottom="4dp"
                android:left="2dp"
                android:right="2dp"
                android:top="0dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#1C3250"
                        android:endColor="#122237" />
                    <stroke
                        android:width="1.3dp"
                        android:color="#365E8A" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
