<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item
                android:left="2dp"
                android:right="2dp"
                android:top="5dp"
                android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#00BFFF" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#FFFFFF" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- 3D Shadow -->
            <item
                android:left="2dp"
                android:right="2dp"
                android:top="4dp"
                android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#003C59" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <!-- 3D Raised Face -->
            <item
                android:left="2dp"
                android:right="2dp"
                android:top="0dp"
                android:bottom="4dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#00A3E0"
                        android:endColor="#006B99" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#40E6FF" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
